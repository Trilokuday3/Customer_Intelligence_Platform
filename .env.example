# Copy to .env and fill in for local development. Never commit .env.

# --- PostgreSQL (Phase 9+) ---
POSTGRES_USER=cip
POSTGRES_PASSWORD=changeme
POSTGRES_DB=customer_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
DATABASE_URL=postgresql://cip:changeme@localhost:5439/customer_intelligence

# --- MLflow (Phase 11) ---
# Optional. Unset, scripts/build_backend_data.py tracks to a local
# sqlite:///mlflow.db + ./mlruns (both gitignored) -- no server needed.
# Uncomment to point at a running `mlflow server` instead:
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- API (Phase 9+) ---
API_HOST=0.0.0.0
API_PORT=8000
